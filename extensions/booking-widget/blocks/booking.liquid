{%- comment -%}
  Booking button + popup for service products.

  Renders hidden; the theme's own add-to-cart shows first. Variants the app
  flagged as services (variant metafield service_booking.bookable, written
  when a service is saved) are listed in data-bookable-variants, so right
  after the page paints booking.js relabels the theme's button "Select a time"
  with no network wait ("Buy it now" is hidden). It then loads availability
  through the /apps/booking proxy in the background, and backs out if the app
  says the variant isn't bookable after all.

  The popup has two steps: [data-sb-step1] (calendar + times) and, once a time
  is picked, [data-sb-details] (people, questions, signature, add-ons — drawn
  by booking-step2.js, loaded on demand). Its "Add to cart" [data-sb-add]
  holds the seats and adds the booking plus any add-ons to the cart.

  Add-ons come from the service variant's service_booking.upsells metafield
  (a variant-reference list the app writes) and are rendered here, one
  <template> per variant, so showing them needs no request.

  The [data-sb-open] button is only a fallback for themes whose add-to-cart
  can't be found.
{%- endcomment -%}

{%- if product -%}
  <div
    class="sb-booking"
    hidden
    data-sb-booking
    data-label="{{ block.settings.button_label | default: 'Select a time' | escape }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-bookable-variants="{%- for v in product.variants -%}{%- if v.metafields.service_booking.bookable == true -%}{{ v.id }},{%- endif -%}{%- endfor -%}"
    data-proxy="/apps/booking"
    data-step2-src="{{ 'booking-step2.js' | asset_url }}"
    data-week-start="{{ block.settings.week_start }}"
    data-i18n-timezone="{{ 'booking.timezone' | t: zone: '__ZONE__' | escape }}"
    data-i18n-close="{{ 'booking.close' | t | escape }}"
    data-i18n-loading="{{ 'booking.loading' | t | escape }}"
    data-i18n-no-dates="{{ 'booking.no_dates' | t | escape }}"
    data-i18n-no-times="{{ 'booking.no_times' | t | escape }}"
    data-i18n-previous-month="{{ 'booking.previous_month' | t | escape }}"
    data-i18n-next-month="{{ 'booking.next_month' | t | escape }}"
    data-i18n-pick-time="{{ 'booking.pick_time' | t | escape }}"
    data-i18n-available="{{ 'booking.available' | t: count: '__COUNT__', total: '__TOTAL__' | escape }}"
    data-i18n-back="{{ 'booking.back' | t | escape }}"
    data-i18n-selected-time="{{ 'booking.selected_time' | t | escape }}"
    data-i18n-from-to="{{ 'booking.from_to' | t: date: '__DATE__', start: '__START__', end: '__END__' | escape }}"
    data-i18n-people="{{ 'booking.people' | t | escape }}"
    data-i18n-people-help="{{ 'booking.people_help' | t: max: '__MAX__' | escape }}"
    data-i18n-signature="{{ 'booking.signature' | t | escape }}"
    data-i18n-signature-help="{{ 'booking.signature_help' | t | escape }}"
    data-i18n-clear-signature="{{ 'booking.clear_signature' | t | escape }}"
    data-i18n-add-these="{{ 'booking.add_these' | t | escape }}"
    data-i18n-add="{{ 'booking.add' | t | escape }}"
    data-i18n-added="{{ 'booking.added' | t | escape }}"
    data-i18n-adding="{{ 'booking.adding' | t | escape }}"
    data-i18n-required="{{ 'booking.required' | t | escape }}"
    data-i18n-yes="{{ 'booking.yes' | t | escape }}"
    data-i18n-taken="{{ 'booking.taken' | t | escape }}"
    data-i18n-error="{{ 'booking.error' | t | escape }}"
    data-i18n-hour12="{{ 'booking.hour_12' | t | escape }}"
    data-i18n-hour24="{{ 'booking.hour_24' | t | escape }}"
    style="--sb-accent: {{ block.settings.accent }};"
    {{ block.shopify_attributes }}
  >
    <button type="button" class="sb-trigger" data-sb-open>
      {{- block.settings.button_label | default: 'Select a time' | escape -}}
    </button>

    {%- for v in product.variants -%}
      {%- assign upsells = v.metafields.service_booking.upsells.value -%}
      {%- if upsells != blank -%}
        <template data-sb-upsells data-for="{{ v.id }}">
          {%- for u in upsells -%}
            {%- if u.available -%}
              <div class="sb-upsell" data-id="{{ u.id }}" data-title="{{ u.product.title | escape }}">
                {%- assign img = u.image | default: u.product.featured_image -%}
                {%- if img -%}
                  {{ img | image_url: width: 120 | image_tag: class: 'sb-upsell__img', loading: 'lazy', alt: '' }}
                {%- endif -%}
                <div class="sb-upsell__info">
                  <span class="sb-upsell__title">{{ u.product.title | escape }}</span>
                  {%- unless u.product.has_only_default_variant -%}
                    <small>{{ u.title | escape }}</small>
                  {%- endunless -%}
                </div>
                <span class="sb-upsell__price">{{ u.price | money }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </template>
      {%- endif -%}
    {%- endfor -%}

    <dialog class="sb-modal" aria-labelledby="sb-title-{{ block.id }}" data-sb-dialog>
      <div class="sb-modal__panel">
        <header class="sb-modal__head">
          <div>
            <h2 class="sb-modal__title" id="sb-title-{{ block.id }}" data-sb-title>
              {{- product.title | escape -}}
            </h2>
            <p class="sb-modal__zone" data-sb-zone></p>
            {%- if block.settings.description != blank -%}
              <p class="sb-modal__desc">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
          <button type="button" class="sb-modal__close" data-sb-close aria-label="{{ 'booking.close' | t | escape }}">
            &times;
          </button>
        </header>
        <div class="sb-modal__body" data-sb-step1>
          <div class="sb-cal" data-sb-calendar></div>
          <div class="sb-times" data-sb-times></div>
        </div>
        <div class="sb-details" data-sb-details hidden></div>
        <footer class="sb-modal__foot">
          <p class="sb-modal__status" role="status" aria-live="polite" data-sb-status></p>
          <button type="button" class="sb-add" data-sb-add hidden>
            {{- 'booking.add_to_cart' | t -}}
          </button>
        </footer>
      </div>
    </dialog>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Book a time",
  "target": "section",
  "javascript": "booking.js",
  "stylesheet": "booking.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Select a time"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Popup message",
      "default": "You'll receive a confirmation email after checkout."
    },
    {
      "type": "select",
      "id": "week_start",
      "label": "Week starts on",
      "options": [
        { "value": "0", "label": "Sunday" },
        { "value": "1", "label": "Monday" }
      ],
      "default": "0"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent colour",
      "default": "#000000"
    }
  ]
}
{% endschema %}
