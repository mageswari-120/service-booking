{%- comment -%}
  The booking popup ("In a popup"): service cards → staff, calendar and
  times → details and add-ons → hold → cart. Driven by booking.js (source
  storefront/booking-widget.js) and booking-step2.js.

  Rendered by "Book a time" (blocks/booking.liquid) on a service's product
  page, where the theme's add-to-cart opens it, and by "Booking calendar"
  (blocks/booking-calendar.liquid, layout "Service cards"), where its own
  button does — `standalone` tells booking.js not to look for (and take
  over) a product form.

  Parameters: block, variant_id (the service it starts on), bookable_ids
  ("id,id," — shown at once, before the proxy confirms), label, title,
  description, add_label (the footer button; blank: the translated
  "Add to cart"), variants (whose add-on templates to render; may be empty —
  the popup then fetches add-ons from /upsells), standalone.
{%- endcomment -%}
<div
  class="sb-booking"
  hidden
  data-sb-booking
  data-label="{{ label | escape }}"
  data-variant-id="{{ variant_id }}"
  data-bookable-variants="{{ bookable_ids }}"
  {% if standalone %}data-standalone{% endif %}
  data-proxy="/apps/booking"
  data-step2-src="{{ 'booking-step2.js' | asset_url }}"
  data-after-add="{{ block.settings.after_add }}"
  data-week-start="{{ block.settings.week_start }}"
  data-i18n-timezone="{{ 'booking.timezone' | t: zone: '__ZONE__' }}"
  data-i18n-close="{{ 'booking.close' | t }}"
  data-i18n-loading="{{ 'booking.loading' | t }}"
  data-i18n-no-dates="{{ 'booking.no_dates' | t }}"
  data-i18n-no-times="{{ 'booking.no_times' | t }}"
  data-i18n-previous-month="{{ 'booking.previous_month' | t }}"
  data-i18n-next-month="{{ 'booking.next_month' | t }}"
  data-i18n-pick-time="{{ 'booking.pick_time' | t }}"
  data-i18n-available="{{ 'booking.available' | t: count: '__COUNT__', total: '__TOTAL__' }}"
  data-i18n-spots-left="{{ 'booking.spots_left' | t: count: '__COUNT__' }}"
  data-i18n-back="{{ 'booking.back' | t }}"
  data-i18n-selected-time="{{ 'booking.selected_time' | t }}"
  data-i18n-from-to="{{ 'booking.from_to' | t: date: '__DATE__', start: '__START__', end: '__END__' }}"
  data-i18n-people="{{ 'booking.people' | t }}"
  data-i18n-people-help="{{ 'booking.people_help' | t: max: '__MAX__' }}"
  data-i18n-people-help-range="{{ 'booking.people_help_range' | t: min: '__MIN__', max: '__MAX__' }}"
  data-i18n-people-help-exact="{{ 'booking.people_help_exact' | t: count: '__COUNT__' }}"
  data-i18n-signature="{{ 'booking.signature' | t }}"
  data-i18n-signature-help="{{ 'booking.signature_help' | t }}"
  data-i18n-clear-signature="{{ 'booking.clear_signature' | t }}"
  data-i18n-add-these="{{ 'booking.add_these' | t }}"
  data-i18n-add="{{ 'booking.add' | t }}"
  data-i18n-added="{{ 'booking.added' | t }}"
  data-i18n-adding="{{ 'booking.adding' | t }}"
  data-i18n-appointment-date="{{ 'booking.appointment_date' | t }}"
  data-i18n-appointment-time="{{ 'booking.appointment_time' | t }}"
  data-i18n-duration="{{ 'booking.duration' | t }}"
  data-i18n-minutes="{{ 'booking.minutes' | t: count: '__COUNT__' }}"
  data-i18n-required="{{ 'booking.required' | t }}"
  data-i18n-yes="{{ 'booking.yes' | t }}"
  data-i18n-taken="{{ 'booking.taken' | t }}"
  data-i18n-error="{{ 'booking.error' | t }}"
  data-i18n-hour12="{{ 'booking.hour_12' | t }}"
  data-i18n-hour24="{{ 'booking.hour_24' | t }}"
  data-i18n-choose-service="{{ 'booking.choose_service' | t }}"
  data-i18n-choose-service-help="{{ 'booking.choose_service_help' | t }}"
  data-i18n-change="{{ 'booking.change' | t }}"
  data-i18n-free="{{ 'booking.free' | t }}"
  data-i18n-choose-staff="{{ 'booking.choose_staff' | t }}"
  data-i18n-any-staff="{{ 'booking.any_staff' | t }}"
  data-i18n-staff="{{ 'booking.staff' | t }}"
  data-i18n-unavailable="{{ 'booking.unavailable' | t }}"
  data-i18n-total="{{ 'booking.total' | t }}"
  data-i18n-total-note="{{ 'booking.total_note' | t }}"
  data-i18n-add-ons="{{ 'booking.add_ons' | t }}"
  {%- if block.settings.accent_source == 'custom' %}
    style="--sb-accent: {{ block.settings.accent }};"
  {%- endif %}
  {{ block.shopify_attributes }}
>
  <button type="button" class="sb-trigger" data-sb-open>
    {{- label | escape -}}
  </button>

  {%- for v in variants -%}
    {%- assign upsells = v.metafields.service_booking.upsells.value -%}
    {%- if upsells != blank -%}
      <template data-sb-upsells data-for="{{ v.id }}">
        {%- for u in upsells -%}
          {%- if u.available -%}
            <div class="sb-upsell" data-id="{{ u.id }}" data-price="{{ u.price }}" data-title="{{ u.product.title | escape }}">
              {%- assign img = u.image | default: u.product.featured_image -%}
              {%- if img -%}
                {{ img | image_url: width: 120 | image_tag: class: 'sb-upsell__img', loading: 'lazy', alt: '' }}
              {%- endif -%}
              <div class="sb-upsell__info">
                <span class="sb-upsell__title">{{ u.product.title | escape }}</span>
                {%- unless u.product.has_only_default_variant -%}
                  <small>{{ u.title | escape }}</small>
                {%- endunless -%}
              </div>
              <span class="sb-upsell__price">{% if u.price == 0 %}{{ 'booking.free' | t }}{% else %}{{ u.price | money }}{% endif %}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </template>
    {%- endif -%}
  {%- endfor -%}

  <dialog class="sb-modal" aria-labelledby="sb-title-{{ block.id }}" data-sb-dialog>
    <div class="sb-modal__panel">
      <header class="sb-modal__head">
        <div>
          <h2 class="sb-modal__title" id="sb-title-{{ block.id }}" data-sb-title>
            {{- title | escape -}}
          </h2>
          <p class="sb-modal__zone" data-sb-zone></p>
          {%- if description != blank -%}
            <p class="sb-modal__desc">{{ description | escape }}</p>
          {%- endif -%}
        </div>
        <button type="button" class="sb-modal__close" data-sb-close aria-label="{{ 'booking.close' | t }}">
          &times;
        </button>
      </header>
      {%- comment -%}
        The standalone popup ("Book now") with 2+ active services opens on
        the service cards (booking-extras.js), so the first paint shows the
        cards' skeleton,
        not the calendar's; the real cards replace it. The app keeps the
        active service count on the shop: only an explicit 0 or 1 starts on
        the calendar. Unknown (not written yet) assumes cards — booking.js
        switches back to the calendar if the shop turns out to have one.
        A product page's popup opens on its own service (summary, staff,
        calendar): the calendar skeleton, the summary row added on load.
      {%- endcomment -%}
      {%- assign sb_count = shop.metafields.service_booking.service_count.value -%}
      {%- assign sb_cards = standalone -%}
      {%- assign sb_skeletons = 3 -%}
      {%- if sb_count != blank -%}
        {%- if sb_count < 2 -%}
          {%- assign sb_cards = false -%}
        {%- else -%}
          {%- assign sb_skeletons = sb_count | at_most: 6 -%}
        {%- endif -%}
      {%- endif -%}
      <div class="sb-modal__body{% if sb_cards %} sb-step-service{% endif %}" data-sb-step1>
        {%- if sb_cards -%}
          <div class="sb-services" data-sb-services>
            <p class="sb-field__label">{{ 'booking.choose_service' | t }}</p>
            <p class="sb-muted">{{ 'booking.choose_service_help' | t }}</p>
            <div class="sb-cards" aria-hidden="true">
              {%- for i in (1..sb_skeletons) -%}
                <div class="sb-card sb-card--skeleton">
                  <span class="sb-card__thumb"></span>
                  <span class="sb-card__body">
                    <span class="sb-skel-bar"></span>
                    <span class="sb-skel-bar sb-skel-bar--short"></span>
                  </span>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <div class="sb-services" data-sb-services hidden></div>
        {%- endif -%}
        <div class="sb-cal" data-sb-calendar></div>
        <div class="sb-times" data-sb-times></div>
      </div>
      <div class="sb-details" data-sb-details hidden></div>
      <footer class="sb-modal__foot">
        <p class="sb-modal__status" role="status" aria-live="polite" data-sb-status></p>
        <button type="button" class="sb-add" data-sb-add hidden>
          {%- if add_label != blank -%}{{ add_label | escape }}{%- else -%}{{ 'booking.add_to_cart' | t }}{%- endif -%}
        </button>
      </footer>
    </div>
  </dialog>
</div>
