{%- comment -%}
  Booking calendar: a "Book now" button. Two layouts (setting "layout"):

  cards ("Service cards", default) — the same popup as a service's product
    page (snippets/booking-popup.liquid, driven by booking.js): service
    cards → staff, calendar and times → details and add-ons → cart. It
    starts on this product's selected service (scope "Current product" on a
    bookable product) or the shop's service_booking.default_variant (written
    by the app with service_count); without either it falls back to the
    month layout.

  month ("Month overview") — a month view of every
  bookable service (or only this product's), one chip per service per day.
  A chip opens that day's times; "Continue to Book" runs the same details →
  hold → cart flow as the product popup (booking-step2.js).
  Script: booking-calendar.js (source: storefront/booking-calendar.js).
{%- endcomment -%}
{%- liquid
  assign product_id = ''
  if block.settings.scope == 'product' and product
    assign product_id = product.id
  endif
  assign label = block.settings.button_label | default: 'Book now'
  assign heading = block.settings.heading | default: 'Book an appointment'
  assign sb_add_label = 'booking.add_to_cart' | t
  if block.settings.add_label != blank
    assign sb_add_label = block.settings.add_label | escape
  endif

  assign sb_start = ''
  if block.settings.layout != 'month'
    if block.settings.scope == 'product' and product
      assign sb_own = product.selected_or_first_available_variant
      if sb_own.metafields.service_booking.bookable == true
        assign sb_start = sb_own.id
      endif
    endif
    if sb_start == blank
      assign sb_start = shop.metafields.service_booking.default_variant.value
    endif
  endif
-%}
{%- if sb_start != blank -%}
  {%- assign sb_ids = sb_start | append: ',' -%}
  <div class="sb-bcal sb-bcal--cards">
    {%- render 'booking-popup',
      block: block,
      variant_id: sb_start,
      bookable_ids: sb_ids,
      label: label,
      title: heading,
      description: '',
      add_label: block.settings.add_label,
      variants: empty,
      standalone: true
    -%}
  </div>
  <script src="{{ 'booking.js' | asset_url }}" defer></script>
{%- else -%}
<div
  class="sb-booking sb-bcal"
  data-sb-cal
  data-proxy="/apps/booking"
  data-product="{{ product_id }}"
  data-step2-src="{{ 'booking-step2.js' | asset_url }}"
  data-after-add="{{ block.settings.after_add }}"
  data-week-start="{{ block.settings.week_start }}"
  data-max-chips="{{ block.settings.max_chips }}"
  data-i18n-loading="{{ 'booking.loading' | t }}"
  data-i18n-error="{{ 'booking.error' | t }}"
  data-i18n-close="{{ 'booking.close' | t }}"
  data-i18n-no-dates="{{ 'booking.no_dates' | t }}"
  data-i18n-no-services="{{ 'booking.no_services' | t }}"
  data-i18n-previous-month="{{ 'booking.previous_month' | t }}"
  data-i18n-next-month="{{ 'booking.next_month' | t }}"
  data-i18n-minutes="{{ 'booking.minutes' | t: count: '__COUNT__' }}"
  data-i18n-select-time="{{ 'booking.select_time' | t }}"
  data-i18n-continue="{{ 'booking.continue_to_book' | t }}"
  data-i18n-add-to-cart="{{ sb_add_label }}"
  data-i18n-sold-out="{{ 'booking.sold_out' | t }}"
  data-i18n-more="{{ 'booking.more' | t: count: '__COUNT__' }}"
  data-i18n-back="{{ 'booking.back' | t }}"
  data-i18n-selected-time="{{ 'booking.selected_time' | t }}"
  data-i18n-from-to="{{ 'booking.from_to' | t: date: '__DATE__', start: '__START__', end: '__END__' }}"
  data-i18n-people="{{ 'booking.people' | t }}"
  data-i18n-people-help="{{ 'booking.people_help' | t: max: '__MAX__' }}"
  data-i18n-people-help-range="{{ 'booking.people_help_range' | t: min: '__MIN__', max: '__MAX__' }}"
  data-i18n-people-help-exact="{{ 'booking.people_help_exact' | t: count: '__COUNT__' }}"
  data-i18n-signature="{{ 'booking.signature' | t }}"
  data-i18n-signature-help="{{ 'booking.signature_help' | t }}"
  data-i18n-clear-signature="{{ 'booking.clear_signature' | t }}"
  data-i18n-adding="{{ 'booking.adding' | t }}"
  data-i18n-appointment-date="{{ 'booking.appointment_date' | t }}"
  data-i18n-appointment-time="{{ 'booking.appointment_time' | t }}"
  data-i18n-duration="{{ 'booking.duration' | t }}"
  data-i18n-required="{{ 'booking.required' | t }}"
  data-i18n-yes="{{ 'booking.yes' | t }}"
  data-i18n-taken="{{ 'booking.taken' | t }}"
  {%- if block.settings.accent_source == 'custom' %}
    style="--sb-accent: {{ block.settings.accent }};"
  {%- endif %}
  {{ block.shopify_attributes }}
>
  <button type="button" class="sb-trigger sb-bcal__open" data-sb-open>
    {{- label | escape -}}
  </button>

  <dialog class="sb-modal sb-bcal__modal" aria-labelledby="sb-cal-title-{{ block.id }}" data-sb-dialog>
    <div class="sb-modal__panel">
      <header class="sb-modal__head">
        <h2 class="sb-modal__title" id="sb-cal-title-{{ block.id }}">{{ heading | escape }}</h2>
        <button type="button" class="sb-modal__close" data-sb-close aria-label="{{ 'booking.close' | t }}">
          &times;
        </button>
      </header>
      <div class="sb-bcal__body">
        <p class="sb-modal__status" role="status" aria-live="polite" data-sb-status></p>
        <div class="sb-bcal__month" data-sb-month></div>
      </div>
    </div>
    <div class="sb-bcal__overlay" data-sb-pop hidden></div>
  </dialog>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Booking calendar",
  "target": "section",
  "javascript": "booking-calendar.js",
  "stylesheet": "booking.css",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Service cards: the same popup as a service's product page — pick a service, then staff, date and time. Month overview: every service's open days on one big calendar.",
      "options": [
        { "value": "cards", "label": "Service cards" },
        { "value": "month", "label": "Month overview" }
      ],
      "default": "cards"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Services shown",
      "info": "Current product: on a product page, Service cards starts on that product's service and Month overview shows only its services. Elsewhere it falls back to all services.",
      "options": [
        { "value": "all", "label": "All services" },
        { "value": "product", "label": "Current product" }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book now"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart button label",
      "info": "The popup's last button. Leave empty for \"Add to cart\" (translated)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Calendar heading",
      "default": "Book an appointment"
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to cart",
      "info": "Opens your theme's cart drawer when it has one; otherwise goes to the cart page.",
      "options": [
        { "value": "drawer", "label": "Open cart drawer" },
        { "value": "page", "label": "Go to cart page" }
      ],
      "default": "drawer"
    },
    {
      "type": "range",
      "id": "max_chips",
      "label": "Services shown per day",
      "info": "More are behind a \"+ more\" link.",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "week_start",
      "label": "Week starts on",
      "options": [
        { "value": "0", "label": "Sunday" },
        { "value": "1", "label": "Monday" }
      ],
      "default": "0"
    },
    {
      "type": "select",
      "id": "accent_source",
      "label": "Accent colour",
      "options": [
        { "value": "theme", "label": "Match my theme" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "theme"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Custom accent colour",
      "info": "Used only when Accent colour is set to Custom.",
      "default": "#000000"
    }
  ]
}
{% endschema %}
